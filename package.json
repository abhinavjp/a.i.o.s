{
  "name": "@adhisthana/console",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "workspaces": [
    "contracts",
    "agents",
    "connectors",
    "app/server",
    "app/client"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "npm run dev -w app/server",
    "dev:client": "npm run dev -w app/client",
    "build:distribution": "node scripts/build-distribution.mjs",
    "prepack": "npm run build:distribution"
  },
  "bin": { "adhisthana": "dist/cli.mjs" },
  "files": ["dist"],
  "dependencies": { "@fastify/cors": "^10.0.1", "fastify": "^5.1.0" },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  }
}
